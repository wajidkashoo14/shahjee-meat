# Copy this file to .env.local and fill in what you have.
# Everything below is optional except DATABASE_URL / BETTER_AUTH_SECRET —
# the app runs fully end-to-end (including checkout, via a "test payment"
# fallback) with just those two set.

# --- Database (SQLite by default; see DECISIONS.md for swapping to Postgres) ---
DATABASE_URL=file:./data/wholecuts.db

# --- Auth (Better Auth) ---
# Any long random string in development. Generate a real secret for production:
#   openssl rand -base64 32
BETTER_AUTH_SECRET=dev-only-insecure-secret-change-me
BETTER_AUTH_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Social login (optional; sign-in falls back to email/password + magic link) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
LINE_CLIENT_ID=
LINE_CLIENT_SECRET=

# --- Stripe (optional; checkout falls back to a "test payment" button when unset) ---
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# --- Email (optional; emails are logged to the server console when unset) ---
RESEND_API_KEY=
EMAIL_FROM="Whole Cuts <no-reply@wholecuts.example>"
